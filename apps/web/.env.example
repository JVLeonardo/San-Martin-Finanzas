# Public application URL used only for local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal URL used by future server-side BFF code.
BACKEND_INTERNAL_URL=http://localhost:8080

# Identity-provider values are intentionally blank until Cognito is configured.
COGNITO_ISSUER_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

SESSION_COOKIE_NAME=smf_session
SESSION_TTL_SECONDS=1800
REDIS_URL=redis://localhost:6379

# Docker Compose overrides this internal URL with http://api:8080.
